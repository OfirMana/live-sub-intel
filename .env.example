# Copy values into the SERVER environment. This file is not loaded automatically.
# Never put credentials in HTML, browser JavaScript, exported JSON or GitHub.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=YOUR-DEPLOYMENT-NAME
# Optional for local development. If absent, use DefaultAzureCredential / Entra ID.
AZURE_OPENAI_API_KEY=
NARRATIVE_TIMEOUT_SECONDS=8
